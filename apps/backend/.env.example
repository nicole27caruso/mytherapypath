DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mytherapypath
SECRET_KEY=change-this-to-a-random-string
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional — leave unset for local dev (submissions are saved to ./uploads instead).
# Set both when deploying so uploaded photos/videos go to Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=submissions
